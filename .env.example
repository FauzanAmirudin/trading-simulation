# ==========================================
# TRADING SIMULATION — ENVIRONMENT CONFIG
# ==========================================

# Port Server Aplikasi
PORT=3000
NODE_ENV=production

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=trading_simulasi

# Database Connection URL (Docker Compose)
DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/trading_simulasi

# PGAdmin (Opsional)
PGADMIN_EMAIL=admin@trading.com
PGADMIN_PASSWORD=admin
